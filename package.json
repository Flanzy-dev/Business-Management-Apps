{
  "name": "surya-baru",
  "version": "1.1.2",
  "description": "Surya Baru - Service Console - Local desktop application",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run electron:build && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "build:server": "tsc -p tsconfig.server.json",
    "electron:build": "npm run build:server && tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:build && concurrently \"vite\" \"electron .\"",
    "electron:open": "npm run electron:build && vite build && electron .",
    "package": "npm run electron:build && vite build && electron-builder",
    "server": "node dist-server/server/index.js"
  },
  "keywords": [
    "surya-baru",
    "shop-management",
    "electron",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.suryabaru.serviceconsole",
    "productName": "Surya Baru",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-server/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "prisma": "^5.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@noble/hashes": "^2.3.0",
    "@prisma/client": "^5.8.1",
    "@types/sql.js": "^1.4.11",
    "lucide-react": "^1.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "recharts": "^3.8.1",
    "sql.js": "^1.14.1",
    "zustand": "^4.5.0"
  }
}
