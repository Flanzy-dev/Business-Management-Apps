// NOTE: this schema is still not the live backing store. The app's actual
// runtime persistence (as of the P0 fix in the impeccable audit) is real
// SQLite too, but reached via sql.js in electron/main.ts through a generic
// synchronous key_value_store table, not through Prisma or these relational
// models — see src/lib/storageAdapter.ts. Prisma was not used for that bridge
// because its client is Promise-only, and the renderer bridge needs to stay
// fully synchronous (electron/preload.ts uses ipcRenderer.sendSync) so none
// of the 16 Zustand `persist` stores in src/store/*.ts had to change.
//
// This file remains a loose, best-effort mirror of those store shapes,
// documenting the target shape for a possible future migration to real
// per-entity relational tables and queries (needed for anything beyond
// in-memory filtering, e.g. real SQL reporting) — it can drift from the
// stores until that migration happens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Individual customers
model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]
}

// Fleet/corporate accounts
model Company {
  id             String    @id @default(uuid())
  companyName    String
  contactPerson  String?
  phone          String?
  email          String?
  billingAddress String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  drivers        Driver[]
  vehicles       Vehicle[]
}

// Employees of companies who bring in fleet vehicles
model Driver {
  id         String      @id @default(uuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  employeeId String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workOrders WorkOrder[]
}

// Vehicles - can belong to customer OR company
model Vehicle {
  id                     String      @id @default(uuid())
  customerId             String?
  customer               Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  companyId              String?
  company                Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Basic info
  make                   String
  model                  String
  year                   Int?
  vin                    String?
  licensePlate           String?
  color                  String?
  currentMileage         Int?
  // Engine info
  engineType             String?
  engineSize             String?
  oilTypeRequired        String?
  oilCapacity            String?
  // Transmission info
  transmissionType       String?     // automatic, manual, CVT
  transmissionFluidType  String?
  // Gardan / Differential info
  driveType              String?     // FWD, RWD, AWD, 4WD
  differentialFluidType  String?
  // Meta
  notes                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  workOrders             WorkOrder[]
  scheduleRules          ScheduleRule[]
  serviceEvents          ServiceEvent[]
}

// Shop technicians
model Worker {
  id         String      @id @default(uuid())
  name       String
  phone      String?
  employeeId String?
  hireDate   DateTime?
  isActive   Boolean     @default(true)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workOrders WorkOrder[]
}

// Suppliers / Vendors
model Supplier {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// Products / Inventory items
model Product {
  id             String          @id @default(uuid())
  name           String
  sku            String?
  supplierCode   String?         // supplier price-list ("modal") code, uppercase; repeats across products
  category       String?
  unit           String?         // liter, each, case, box, etc.
  costPrice      Int             @default(0)  // whole Rupiah
  sellPrice      Int             @default(0)  // whole Rupiah
  qtyOnHand      Int             @default(0)
  reorderPoint   Int             @default(0)
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workOrderItems WorkOrderItem[]
}

// Work Orders (main transaction)
model WorkOrder {
  id            String          @id @default(uuid())
  orderNumber   Int?
  vehicleId     String
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id])
  workerId      String?
  worker        Worker?         @relation(fields: [workerId], references: [id], onDelete: SetNull)
  driverId      String?         // for fleet vehicles
  driver        Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  odometerAtArrival Int?        // captured at intake
  odometerAtService Int?        // confirmed/adjusted at completion
  date          DateTime        @default(now())
  subtotal      Int             @default(0)  // whole Rupiah
  discount      Int             @default(0)  // whole Rupiah
  tax           Int             @default(0)  // whole Rupiah
  total         Int             @default(0)  // whole Rupiah
  paymentMethod String?         // cash, card, check
  status        String          @default("open")  // open, completed, cancelled
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  items         WorkOrderItem[]
}

// Line items on a work order
model WorkOrderItem {
  id                String    @id @default(uuid())
  workOrderId       String
  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  description       String
  quantity          Int       @default(1)
  unitPrice         Int       @default(0)  // whole Rupiah
  lineTotal         Int       @default(0)  // whole Rupiah
  // Optional service-schedule tagging — null for ordinary parts/labor lines.
  serviceItemTypeId String?
  serviceItemType   ServiceItemType? @relation(fields: [serviceItemTypeId], references: [id], onDelete: SetNull)
  quantityLiters    Float?
  serviceAction     String?   // "changed" | "topped_up"
  containerType     String?   // "bottle" | "drum" | "gallon"
  createdAt         DateTime  @default(now())
}

// Configurable taxonomy of schedulable service items (Oli Mesin, Filter Oli,
// Oli Transmisi, Oli Gardan, Filter Solar, Minyak Rem, Minyak Power Steering,
// and whatever else a shop adds). Referenced by id, never by name.
model ServiceItemType {
  id             String          @id @default(uuid())
  name           String
  createdAt      DateTime        @default(now())
  scheduleRules  ScheduleRule[]
  workOrderItems WorkOrderItem[]
  serviceEventItems ServiceEventItem[]
}

// Fixed cadence for one (vehicle, item type) pair. Never edited in place —
// changing interval/base/source supersedes the current row and inserts a
// replacement, so old marks stay in the audit trail instead of being erased.
model ScheduleRule {
  id              String          @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  itemTypeId      String
  itemType        ServiceItemType @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  intervalKm      Int
  baseOdometer    Int
  source          String          // "workshop_default" | "customer_request"
  supersededAt    DateTime?
  supersedesId    String?
  notes           String?
  createdAt       DateTime        @default(now())
}

// One row per visit, generated from a completed WorkOrder's tagged line
// items. Feeds the schedule engine; never guessed or backfilled from
// mileage/odometer alone.
model ServiceEvent {
  id                String             @id @default(uuid())
  vehicleId         String
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workOrderId       String?
  date              DateTime
  odometerAtArrival Int?
  odometerAtService Int?
  notes             String?
  createdAt         DateTime           @default(now())
  items             ServiceEventItem[]
}

model ServiceEventItem {
  id              String          @id @default(uuid())
  serviceEventId  String
  serviceEvent    ServiceEvent    @relation(fields: [serviceEventId], references: [id], onDelete: Cascade)
  itemTypeId      String
  itemType        ServiceItemType @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  action          String          // "changed" | "topped_up"
  quantityLiters  Float?
  containerType   String?         // "bottle" | "drum" | "gallon"
  notes           String?
}

// Manual expense entries
model Expense {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  category    String?
  description String?
  amount      Int      @default(0)  // whole Rupiah
  vendor      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// App settings (key-value store)
model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// Service bays
model Bay {
  id                 String    @id @default(uuid())
  name               String
  status             String    @default("available") // available, in-service, inspection, awaiting-parts
  currentWorkOrderId String?
  assignedWorkerId   String?
  estimatedEndTime   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Appointments and walk-ins
model Appointment {
  id          String   @id @default(uuid())
  vehicleId   String?
  customerId  String?
  companyId   String?
  scheduledAt DateTime
  duration    Int      @default(30)
  serviceType String?
  isWalkIn    Boolean  @default(false)
  status      String   @default("scheduled") // scheduled, arrived, in-progress, completed, cancelled, no-show
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
